{
  "expo": {
    "name": "Yapper",
    "slug": "yapper-rn",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yapper",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yapper.app"
    },
    "android": {
      "package": "com.yapper.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
